# Telegram Bot Settings
# Получите токен у @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID (целевой закрытый канал)
# Пример: -1001234567890 (бот должен быть администратором канала с правом приглашать пользователей!)
CHANNEL_ID=-1001234567890

# Контакт администратора для пользователей (если что-то пойдет не так)
# Пример: @username или https://t.me/username
ADMIN_TELEGRAM_USERNAME=@admin_username

# Провайдер AI: "grok" (xAI), "gemini" или "openai"
AI_PROVIDER=grok

# xAI Grok API Settings (https://console.x.ai)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-vision-1212

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Settings (если AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Параметры инвайт-ссылки
# Срок действия ссылки в часах (0 - бессрочная ссылка)
INVITE_LINK_EXPIRE_HOURS=24
# Лимит использований ссылки (1 = одноразовая, 0 = без ограничений по количеству участников)
INVITE_LINK_MEMBER_LIMIT=0

# Критерии для проверки AI
# Подробно опишите, что модель должна обнаружить на двух скриншотах
VERIFICATION_CRITERIA=Проверь, что на двух предоставленных скриншотах выполнены условия: 1) На первом скриншоте видна подписка на целевой Telegram-канал или профиль; 2) На втором скриншоте видно целевое действие (например, комментарий, репост, оплата или подтверждение заказа).

# Веб-панель администратора
WEB_HOST=0.0.0.0
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# База данных
DATABASE_PATH=bot.db
