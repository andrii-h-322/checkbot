# Telegram Bot Settings
# Получите токен у @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID (целевой закрытый канал)
# Пример: -1001234567890 (бот должен быть администратором канала с правом приглашать пользователей!)
CHANNEL_ID=-1001234567890

# Контакт администратора для пользователей (если что-то пойдет не так)
# Пример: @username или https://t.me/username
ADMIN_TELEGRAM_USERNAME=@admin_username

# Провайдер AI: "grok" (xAI), "gemini" или "openai"
AI_PROVIDER=grok

# xAI Grok API Settings (https://console.x.ai)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.20-non-reasoning

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Settings (если AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Параметры инвайт-ссылки
# Срок действия ссылки в часах (0 - бессрочная ссылка)
INVITE_LINK_EXPIRE_HOURS=24
# Лимит использований ссылки (1 = одноразовая, 0 = без ограничений по количеству участников)
INVITE_LINK_MEMBER_LIMIT=0
# Резервная статическая ссылка (используется, если динамическая генерация недоступна или CHANNEL_ID не указан)
# Пример: https://t.me/+AbCdEfGhIjKlMnOp или https://t.me/your_channel
INVITE_LINK_FALLBACK=

# Критерии для проверки AI (проверка 2 скриншотов комментариев в TikTok с текстом "Мне скинул @fulyashki")
# Модель проверяет наличие интерфейса TikTok и комментариев с указанным текстом
VERIFICATION_CRITERIA=Проверь предоставленные скриншоты (пользователь должен прислать 2 скриншота из TikTok). Критерии проверки: 1) На скриншотах должен быть виден интерфейс TikTok и оставленные комментарии пользователя; 2) Текст комментариев должен содержать фразу 'Мне скинул @fulyashki' или близкий по смыслу вариант (например: 'мне скинул fulyashki', 'скинул @fulyashki', 'от @fulyashki' и т.п.); 3) На скриншотах должны быть разные видео/комментарии или подтверждение выполнения двух комментариев; 4) Если на скриншотах четко видны комментарии в TikTok с упоминанием @fulyashki — одобри заявку (approved=true) и в поле 'reason' напиши вежливое подтверждение на русском языке; 5) Если скриншоты не из TikTok, комментарии отсутствуют, не содержат нужного текста, неразборчивы или условие не выполнено — отклони (approved=false) и вежливо, понятно объясни пользователю на русском языке причину отказа и что нужно исправить.

# Веб-панель администратора
WEB_HOST=0.0.0.0
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# База данных
DATABASE_PATH=bot.db
